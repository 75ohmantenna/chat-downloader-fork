{
    "default": {
        "template": "{time_text|timestamp}{author.badges}{money.text}{author.display_name|author.name}{message}",
        "keys": {
            "time_text": "{} | ",
            "timestamp": {
                "template": "{} | ",
                "format": "%Y-%m-%d %H:%M:%S"
            },
            "received_timestamp": {
                "template": "{} [received] | ",
                "format": "%Y-%m-%d %H:%M:%S"
            },
            "author.badges": {
                "template": "({}) ",
                "separator": ", "
            },
            "money.text": "*{}* ",
            "message": ": {}"
        }
    },
    "youtube_live_default": [
        {
            "matching": "viewer_engagement_message",
            "template": "{timestamp|time_text}{message}",
            "inherit": "default",
            "keys": {
                "message": "{}"
            }
        },
        {
            "matching": [
                "deleted_message",
                "ban_user"
            ],
            "template": "{timestamp|time_text}{message|target_message_id|author.id|action_type}",
            "inherit": "default",
            "keys": {
                "message": "{}",
                "target_message_id": "[Message removed: {}]",
                "author.id": "[Messages removed for author: {}]",
                "action_type": "[Moderation action: {}]"
            }
        },
        {
            "matching": "all",
            "inherit": "default",
            "template": "{timestamp|time_text}{author.badges}{money.text}{author.display_name|author.name}{message}"
        }
    ],
    "24_hour": {
        "inherit": "default",
        "keys": {
            "timestamp": {
                "format": "%H:%M"
            }
        }
    },
    "youtube_live_24_hour": [
        {
            "matching": "viewer_engagement_message",
            "template": "{timestamp|time_text}{message}",
            "inherit": "default",
            "keys": {
                "timestamp": {
                    "format": "%H:%M"
                },
                "message": "{}"
            }
        },
        {
            "matching": [
                "deleted_message",
                "ban_user"
            ],
            "template": "{timestamp|time_text}{message|target_message_id|author.id|action_type}",
            "inherit": "default",
            "keys": {
                "timestamp": {
                    "format": "%H:%M"
                },
                "message": "{}",
                "target_message_id": "[Message removed: {}]",
                "author.id": "[Messages removed for author: {}]",
                "action_type": "[Moderation action: {}]"
            }
        },
        {
            "matching": "all",
            "inherit": "default",
            "template": "{timestamp|time_text}{author.badges}{money.text}{author.display_name|author.name}{message}",
            "keys": {
                "timestamp": {
                    "format": "%H:%M"
                }
            }
        }
    ],
    "12_hour": {
        "inherit": "default",
        "keys": {
            "timestamp": {
                "template": "{} | ",
                "format": "%I:%M %p"
            }
        }
    },
    "youtube_live_12_hour": [
        {
            "matching": "viewer_engagement_message",
            "template": "{timestamp|time_text}{message}",
            "inherit": "default",
            "keys": {
                "timestamp": {
                    "template": "{} | ",
                    "format": "%I:%M %p"
                },
                "message": "{}"
            }
        },
        {
            "matching": [
                "deleted_message",
                "ban_user"
            ],
            "template": "{timestamp|time_text}{message|target_message_id|author.id|action_type}",
            "inherit": "default",
            "keys": {
                "timestamp": {
                    "template": "{} | ",
                    "format": "%I:%M %p"
                },
                "message": "{}",
                "target_message_id": "[Message removed: {}]",
                "author.id": "[Messages removed for author: {}]",
                "action_type": "[Moderation action: {}]"
            }
        },
        {
            "matching": "all",
            "inherit": "default",
            "template": "{timestamp|time_text}{author.badges}{money.text}{author.display_name|author.name}{message}",
            "keys": {
                "timestamp": {
                    "template": "{} | ",
                    "format": "%I:%M %p"
                }
            }
        }
    ],
    "padded_time": {
        "inherit": "default",
        "keys": {
            "time_text": {
                "template": "{} | ",
                "format": "{:02}:{:02}:{:02}",
                "collapse_leading_zeroes": true
            }
        }
    },
    "youtube":[
        {
            "matching":"viewer_engagement_message",
            "template":"{time_text|timestamp}{message}",
            "inherit": "default",
            "keys": {
                "message": "{}"
            }
        },
        {
            "matching":[
                "deleted_message",
                "ban_user"
            ],
            "template":"{time_text|timestamp}{message|target_message_id|author.id|action_type}",
            "inherit": "default",
            "keys": {
                "message": "{}",
                "target_message_id": "[Message removed: {}]",
                "author.id": "[Messages removed for author: {}]",
                "action_type": "[Moderation action: {}]"
            }
        }
    ],
    "kick": [
        {
            "matching": "message_deleted",
            "template": "{timestamp|received_timestamp|time_text}{metadata.deleted_message_id|message_type}",
            "inherit": "default",
            "keys": {
                "metadata.deleted_message_id": "[Message deleted: {}]",
                "message_type": "[Message deleted]"
            }
        },
        {
            "matching": "user_banned",
            "template": "{timestamp|received_timestamp|time_text}{metadata.user.username|metadata.user.id|message_type}",
            "inherit": "default",
            "keys": {
                "metadata.user.username": "[User banned: {}]",
                "metadata.user.id": "[User banned: {}]",
                "message_type": "[User banned]"
            }
        },
        {
            "matching": "user_unbanned",
            "template": "{timestamp|received_timestamp|time_text}{metadata.user.username|metadata.user.id|message_type}",
            "inherit": "default",
            "keys": {
                "metadata.user.username": "[User unbanned: {}]",
                "metadata.user.id": "[User unbanned: {}]",
                "message_type": "[User unbanned]"
            }
        },
        {
            "matching": "chat_clear",
            "template": "{timestamp|received_timestamp|time_text}{message_type}",
            "inherit": "default",
            "keys": {
                "message_type": "[Chat cleared]"
            }
        },
        {
            "matching": "pinned_message_deleted",
            "template": "{timestamp|received_timestamp|time_text}{metadata.unpinned_message_id|message_type}",
            "inherit": "default",
            "keys": {
                "metadata.unpinned_message_id": "[Pinned message removed: {}]",
                "message_type": "[Pinned message removed]"
            }
        },
        {
            "matching": "pinned_message",
            "template": "{timestamp|received_timestamp|time_text}{message_type}{author.badges}{author.display_name|author.name}{message}",
            "inherit": "default",
            "keys": {
                "message_type": "[Pinned message]",
                "author.badges": {
                    "template": " ({})",
                    "separator": ", "
                },
                "author.display_name": " {}",
                "author.name": " {}",
                "message": " — {}"
            }
        },
        {
            "matching": "subscription",
            "template": "{timestamp|received_timestamp|time_text}{message_type}{author.badges}{author.display_name|author.name}{message}",
            "inherit": "default",
            "keys": {
                "message_type": "[Subscription]",
                "author.badges": {
                    "template": " ({})",
                    "separator": ", "
                },
                "author.display_name": " {}",
                "author.name": " {}",
                "message": " — {}"
            }
        },
        {
            "matching": "gifted_subscriptions",
            "template": "{timestamp|received_timestamp|time_text}{message_type}{author.badges}{author.display_name|author.name}{message}",
            "inherit": "default",
            "keys": {
                "message_type": "[Gifted subscriptions]",
                "author.badges": {
                    "template": " ({})",
                    "separator": ", "
                },
                "author.display_name": " {}",
                "author.name": " {}",
                "message": " — {}"
            }
        },
        {
            "matching": "stream_host",
            "template": "{timestamp|received_timestamp|time_text}{message_type}{author.badges}{author.display_name|author.name}{message}",
            "inherit": "default",
            "keys": {
                "message_type": "[Stream host]",
                "author.badges": {
                    "template": " ({})",
                    "separator": ", "
                },
                "author.display_name": " {}",
                "author.name": " {}",
                "message": " — {}"
            }
        },
        {
            "matching": "all",
            "inherit": "default",
            "template": "{time_text|timestamp|received_timestamp}{author.badges}{money.text}{author.display_name|author.name}{message}"
        }
    ],
    "twitch": [
        {
            "matching": [
                "text_message"
            ],
            "inherit": "default"
        },
        {
            "matching": [
                "ban_user"
            ],
            "template": "{timestamp}{banned_user} was {ban_duration|ban_type}.",
            "inherit": "default",
            "keys": {
                "ban_duration": {
                    "template": "timed out for {} seconds",
                    "singular_template": "timed out for {} second"
                },
                "ban_type": "{}ly banned"
            }
        },
        {
            "matching": [
                "subscription",
                "resubscription",
                "subscription_gift",
                "anonymous_subscription_gift",
                "anonymous_mystery_subscription_gift",
                "mystery_subscription_gift",
                "extend_subscription",
                "standard_pay_forward",
                "community_pay_forward",
                "prime_community_gift_received",
                "prime_paid_upgrade",
                "gift_paid_upgrade",
                "reward_gift",
                "anonymous_gift_paid_upgrade",
                "viewermilestone"
            ],
            "template": "{time_text|timestamp}{author.badges}{system_message}{message}",
            "inherit": "default",
            "keys": {
                "system_message": "{}",
                "message": " — {}"
            }
        },
        {
            "matching": [
                "raid",
                "unraid"
            ],
            "template": "{time_text|timestamp}{author.badges}{system_message|raider_display_name|raider_name|author.display_name|author.name}{message}",
            "inherit": "default",
            "keys": {
                "system_message": "{}",
                "message": " — {}"
            }
        },
        {
            "matching": [
                "highlighted_message"
            ],
            "template": "{time_text|timestamp}[HIGHLIGHTED] {author.badges}{author.display_name|author.name}{message}",
            "inherit": "default"
        },
        {
            "matching": [
                "room_state"
            ],
            "template": "Room state | {channel_id}{emote_only}{follower_only}{minutes_to_follow_before_chatting}{slow_mode}{seconds_to_wait}{subscriber_only}{r9k_mode}{rituals_enabled}",
            "keys": {
                "channel_id": "Channel ID = {}",
                "emote_only": ", emote only = {}",
                "follower_only": ", follower only = {}",
                "seconds_to_wait": " ({} seconds)",
                "minutes_to_follow_before_chatting": " ({} minutes)",
                "slow_mode": ", slow mode = {}",
                "subscriber_only": ", subscriber only = {}",
                "r9k_mode": ", r9k mode = {}",
                "rituals_enabled": ", rituals enabled = {}"
            }
        },
        {
            "matching": "all",
            "inherit": "default"
        }
    ]
}
